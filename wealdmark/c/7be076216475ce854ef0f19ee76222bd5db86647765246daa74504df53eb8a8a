:root {
  --bg: #14101c;
  --panel: #231b33;
  --edge: #5b4a86;
  --ink: #efe6d0;
  --muted: #a89fc0;
  --gold: #e6b34a;
  --bad: #ff7a7a;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  height: 100%;
  background: var(--bg);
  color: var(--ink);
  font-family: Tahoma, Verdana, "Segoe UI", sans-serif;
  font-size: 13px;
  image-rendering: pixelated;
}

.frame {
  max-width: 520px;
  margin: 0 auto;
  padding: 32px 16px;
}

h1 {
  margin: 0;
  color: var(--gold);
  font-size: 32px;
  letter-spacing: 2px;
  text-shadow: 3px 3px 0 #000;
}

.tag { margin: 6px 0 24px; color: var(--muted); }

.panel {
  background: var(--panel);
  border: 4px solid var(--edge);
  box-shadow: 4px 4px 0 #000;
  padding: 20px;
}

.hidden { display: none; }
.muted { color: var(--muted); font-size: 12px; }
.error { color: var(--bad); min-height: 1.4em; margin: 8px 0 0; }

.bar {
  height: 20px;
  border: 3px solid var(--edge);
  background: #0c0912;
  margin: 12px 0;
}
.fill { height: 100%; width: 0; background: var(--gold); transition: width 120ms steps(6); }

label { display: block; margin: 12px 0; }
input[type="text"], input[type="password"], input:not([type]) {
  display: block;
  width: 100%;
  margin-top: 4px;
  padding: 8px;
  background: #0c0912;
  color: var(--ink);
  border: 3px solid var(--edge);
  font: inherit;
}
input:focus { outline: 3px solid var(--gold); outline-offset: 0; }
.check { font-size: 12px; color: var(--muted); }

button {
  font: inherit;
  color: var(--ink);
  background: var(--edge);
  border: 3px solid #000;
  padding: 8px 14px;
  margin: 6px 6px 0 0;
  cursor: pointer;
}
button:hover:not(:disabled) { background: #7560aa; }
button:disabled { opacity: 0.5; cursor: not-allowed; }
button:focus-visible { outline: 3px solid var(--gold); }

.tabs { display: flex; margin-bottom: 8px; }
.tabs button { margin: 0 4px 0 0; background: #36295a; }
.tabs button[aria-selected="true"] { background: var(--edge); color: var(--gold); }

footer { margin-top: 16px; text-align: right; }

/* ---- world view */

#gameview { position: fixed; inset: 0; background: #0c0912; }
#gameview.hidden { display: none; }

#stage {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  image-rendering: pixelated;
  cursor: pointer;
}

#hud {
  position: absolute;
  top: 10px;
  left: 10px;
  padding: 3px 7px;
  background: rgba(20, 16, 28, 0.85);
  border: 2px solid var(--edge);
  font-size: 10px;
  line-height: 1.35;
  white-space: pre;
  pointer-events: none;
}

#toast {
  position: absolute;
  top: 14px;
  left: 50%;
  transform: translateX(-50%);
  padding: 6px 12px;
  background: rgba(20, 16, 28, 0.92);
  border: 3px solid var(--bad);
  opacity: 0;
  transition: opacity 120ms;
  pointer-events: none;
}
#toast.show { opacity: 1; }

#chat {
  position: absolute;
  left: 10px;
  bottom: 10px;
  width: min(380px, calc(var(--vw, 100vw) * 0.34));
  height: 215px;
  min-width: 200px;
  min-height: 110px;
  display: flex;
  flex-direction: column;
}
#chat-grip { position: absolute; right: 0; top: 0; width: 14px; height: 14px; cursor: nesw-resize; z-index: 2; background: linear-gradient(45deg, transparent 50%, var(--gold) 50%); opacity: 0.8; touch-action: none; }
#chatlog {
  list-style: none;
  margin: 0 0 4px;
  padding: 6px 8px;
  flex: 1;
  min-height: 40px;
  overflow-y: auto;
  background: rgba(20, 16, 28, 0.8);
  border: 3px solid var(--edge);
  font-size: 13px;
}
#chatlog li { margin: 1px 0; word-break: break-word; }
#chatlog li.win { color: #9ae89a; }
#chatlog li.levelup { color: var(--gold); font-weight: bold; }
#chatlog li.loot { color: #e8d49a; }
#chatlog li.loot.magic { color: #6aa9ff; }
#chatlog li.loot.rare { color: #ffd24a; }
#chatlog li.loot.legendary { color: #ff8a3a; }
#chatlog li.hint { color: #9fd8ff; font-style: italic; }
#chatlog li.mine { color: var(--gold); }
#chatinput {
  width: 100%;
  padding: 6px 8px;
  background: rgba(12, 9, 18, 0.92);
  color: var(--ink);
  border: 3px solid var(--edge);
  font: inherit;
  font-size: 13px;
}
#toolbar { position: absolute; top: 10px; right: 10px; z-index: 150; }
/* Desktop: the usual row of buttons. The Menu button is for touch screens and small windows. */
#menu-btn { display: none; }
#menu-list, #menu-list.hidden { display: flex; gap: 6px; }
#toolbar button { margin: 0; padding: 6px 10px; font-size: 13px; }

#vitals {
  position: absolute;
  top: 92px;
  left: 10px;
  width: 210px;
  padding: 8px 10px;
  background: rgba(20, 16, 28, 0.85);
  border: 3px solid var(--edge);
  font-size: 13px;
  pointer-events: none;
}
.meter { position: relative; height: 16px; border: 2px solid #000; background: #0c0912; margin-bottom: 5px; }
.meter-fill { height: 100%; width: 0; transition: width 180ms steps(6); }
.meter.hp .meter-fill { background: #4fae6a; }
.meter.mp .meter-fill { background: #4a7fd8; }
.meter.xp { height: 12px; margin-bottom: 2px; }
.meter.xp .meter-fill { background: #b072e6; }
.meter.xp span { line-height: 8px; font-size: 9px; }
#buffs { position: absolute; top: 205px; left: 10px; display: flex; flex-wrap: wrap; gap: 3px; width: 210px; }
#buffs:empty { display: none; }
#buffs .buff { position: relative; width: 28px; height: 28px; border: 2px solid #000; background: #17112a; }
#buffs .buff.good { border-color: #2f6b3a; }
#buffs .buff.debuff { border-color: #8a2f2f; }
#buffs .buff img { width: 100%; height: 100%; image-rendering: pixelated; display: block; }
#buffs .buff .n { position: absolute; right: -2px; bottom: -3px; font-size: 10px; line-height: 10px; padding: 0 2px; background: #000; color: #fff; }
#rctl { position: absolute; top: 56px; right: 10px; display: flex; gap: 3px; z-index: 6; }
#recenter { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); z-index: 7; margin: 0; padding: 4px 12px; min-height: 28px; font-size: 12px; white-space: nowrap; }
#recenter.hidden { display: none; }
@media (pointer: coarse) { #recenter { min-height: 40px; } }
.fbox { position: absolute; display: flex; flex-direction: column; min-width: 90px; min-height: 60px; overflow: hidden; resize: both; background: rgba(20, 16, 28, 0.9); border: 3px solid var(--edge); z-index: 5; }
.fbox.off, .fbox.hidden { display: none; }
.fgrip { flex: none; padding: 0 6px; font-size: 11px; line-height: 16px; color: var(--gold); background: #2a2040; cursor: move; user-select: none; touch-action: none; }
#mapbox { top: 84px; right: 10px; width: 150px; height: 209px; }
#minimap { flex: 1; min-height: 0; width: 100%; object-fit: contain; border: 0; opacity: 1; }
#tracker { flex: 1; min-height: 0; overflow-y: auto; width: auto; border: 0; background: transparent; }
#rctl button { margin: 0; padding: 1px 6px; min-width: 22px; font-size: 11px; line-height: 16px; }
#rctl button.off { opacity: 0.55; }#vitals,
#vitals .meter.hp,
#vitals .meter.mp { display: none; }
#buffs { top: 170px; }
#bhud { position: absolute; left: calc(min(380px, calc(var(--vw, 100vw) * 0.34)) + 24px); right: 10px; bottom: 10px; max-width: 760px; display: flex; align-items: flex-end; gap: 8px; pointer-events: none; }
#bhud > * { pointer-events: auto; }
.globe { --fill: 100%; position: relative; width: 84px; height: 84px; flex: none; border-radius: 50%; border: 3px solid #2a2236; background: #120d1c; overflow: hidden; }
.globe:before { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: var(--fill); transition: height 180ms steps(6); }
.globe.hp:before { background: #c2413f; }
.globe.mp:before { background: #3f6fd0; }
.globe span { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 12px; text-shadow: 1px 1px 0 #000; }
.qcol { display: flex; flex-direction: column; gap: 4px; flex: none; }
.qslot, .sslot, .bslot { position: relative; margin: 0; padding: 0; border: 2px solid #000; background: #17112a; color: var(--ink); font: inherit; cursor: pointer; }
.qslot, .sslot { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
#hotcol { flex: 1; min-width: 0; display: flex; flex-direction: column; }
#hotmid { flex: 1; min-width: 0; display: flex; flex-direction: column; }
#hotcol .meter.xp { margin: 0 0 14px; position: relative; height: 16px; border: 2px solid #8a5fd0; background: #120a22; }
#hotcol .meter.xp .meter-fill { background: linear-gradient(#ffe48a, #f0b429 55%, #b8801a); }
#hotcol .meter.xp::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, transparent calc(25% - 1px), #000 calc(25% - 1px) calc(25% + 1px), transparent calc(25% + 1px) calc(50% - 1px), #000 calc(50% - 1px) calc(50% + 1px), transparent calc(50% + 1px) calc(75% - 1px), #000 calc(75% - 1px) calc(75% + 1px), transparent calc(75% + 1px)); }
#hotcol .meter.xp.gain { animation: xpgain 700ms ease-out; }
@keyframes xpgain { 0% { box-shadow: 0 0 0 0 #ffd75e; filter: brightness(1.6); } 100% { box-shadow: 0 0 10px 0 transparent; filter: none; } }
#hotcol .meter.xp span { line-height: 12px; font-size: 11px; font-weight: bold; letter-spacing: 0.5px; }
#hotrow { display: flex; align-items: flex-end; gap: 4px; }
#hotbar { position: relative; flex: none; min-width: 0; display: flex; gap: 4px; }
#hotbar:before { content: attr(data-style) " bar"; position: absolute; left: 2px; top: -13px; font-size: 9px; line-height: 10px; letter-spacing: 1px; text-transform: uppercase; color: #8a80a8; text-shadow: 1px 1px 0 #000; pointer-events: none; }
.bslot { flex: 1; max-width: 48px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; }
.bslot img, .bslot canvas.icon, .qslot canvas.icon, .sslot canvas.icon { width: 80%; height: 80%; image-rendering: pixelated; }
.bslot.off, .qslot.off, .sslot.off { filter: grayscale(0.8) brightness(0.65); }
.bslot.empty { border-style: dashed; border-color: #3a2f55; }
.bslot.selected { outline: 3px solid var(--gold); }
.bslot.held { border-color: var(--gold); }
.bslot .hk, .qslot .hk, .sslot .hk { position: absolute; left: 1px; top: 0; font-size: 9px; line-height: 10px; padding: 0 2px; background: #000; color: #f0c860; }
.bslot .cost { position: absolute; right: 1px; bottom: 0; font-size: 9px; line-height: 10px; padding: 0 2px; background: #1c3a78; color: #cfe0ff; }
.bslot .cd { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 15px; background: rgba(0, 0, 0, 0.65); }
.qslot .cnt { position: absolute; right: 1px; bottom: 0; font-size: 10px; line-height: 11px; padding: 0 2px; background: #000; color: #fff; }
.qslot.town { font-size: 10px; color: #cfe0ff; }
.qslot .plus { font-size: 11px; color: #8a80a8; }
.bslot.auto { flex-direction: column; gap: 1px; border-color: #6a5a9a; font-size: 9px; line-height: 1.1; }
.bslot.auto b { font-weight: normal; color: #e8e0f0; }
.bslot.auto.on { border-color: #2f6b3a; background: #1d3a24; }
.bslot.auto.on .st { color: #7bd88f; }
#bar-picker { position: absolute; z-index: 26; left: calc(min(380px, calc(var(--vw, 100vw) * 0.34)) + 24px); bottom: 112px; width: 250px; max-height: calc(var(--vh, 100vh) * 0.5); overflow-y: auto; padding: 6px; background: rgba(20, 16, 28, 0.96); border: 3px solid var(--edge); font-size: 12px; }
#bar-picker h4 { margin: 0 0 4px; color: var(--gold); font-weight: normal; font-size: 12px; }
#bar-picker .pick { display: flex; align-items: center; gap: 6px; width: 100%; margin: 2px 0; padding: 3px 6px; text-align: left; font-size: 12px; }
#bar-picker .pick img, #bar-picker .pick canvas { width: 20px; height: 20px; image-rendering: pixelated; }
#minimap { background: #0c0912; image-rendering: pixelated; }
#tracker { padding: 5px 7px; font-size: 12px; }
#tracker .tq + .tq { margin-top: 5px; padding-top: 4px; border-top: 1px solid #3a2f55; }
#tracker b { color: var(--gold); font-weight: normal; }
#tracker .ok { color: #7bd88f; }
#tracker .short { color: #e8c070; }
.meter span { position: absolute; inset: 0; text-align: center; line-height: 12px; font-size: 11px; text-shadow: 1px 1px 0 #000; }
#wallet { display: flex; align-items: center; gap: 5px; margin-top: 2px; }
#wallet span:not(.coin) { margin-right: 8px; min-width: 14px; white-space: nowrap; flex: none; }
