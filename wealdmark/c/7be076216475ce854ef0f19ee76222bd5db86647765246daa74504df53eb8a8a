#hover-tip {
  position: absolute;
  z-index: 30;
  max-width: 240px;
  padding: 6px 9px;
  background: rgba(20, 16, 28, 0.95);
  border: 2px solid var(--edge);
  pointer-events: none;
  font-size: 12px;
  line-height: 1.35;
}
#hover-tip.hidden { display: none; }
#node-menu {
  position: fixed;
  z-index: 40;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 5px;
  background: rgba(20, 16, 28, 0.97);
  border: 2px solid var(--edge);
}
#node-menu.hidden { display: none; }
#node-menu .act { text-align: left; }
#hover-tip .tip-title { color: var(--gold); font-size: 13px; margin-bottom: 2px; }
#hover-tip .tip-line { color: var(--muted); }
button.act { margin: 0; padding: 6px 9px; font-size: 13px; }
button.act.selected { outline: 3px solid var(--gold); background: #7560aa; }

.side {
  position: absolute;
  top: 56px;
  right: 10px;
  width: 272px;
  min-width: 220px;
  min-height: 90px;
  max-height: calc(var(--vh, 100vh) - 70px);
  max-width: calc(var(--vw, 100vw) - 20px);
  resize: both;
  overflow: auto;
  overflow-x: hidden;
  overflow-wrap: anywhere;
  user-select: none;
  padding: 12px 16px;
  background: rgba(20, 16, 28, 0.94);
  border: 3px solid var(--edge);
  font-size: 14px;
  line-height: 1.4;
}
.side.hidden { display: none; }
.side h2 { margin: 0 0 8px; color: var(--gold); font-size: 17px; }
/* Plain buttons inside windows get taller rows; slots, close buttons and the tab strips keep their own size. */
.side button:not(.slot):not(.xbtn):not(.tab) { min-height: 28px; font-size: 14px; }
.side h2.grip { cursor: move; user-select: none; }
.side input, .side textarea { user-select: text; }
.side label { display: block; margin: 8px 0; }
.side input[type="range"] { width: 100%; }
#skill-points { margin: 6px 0; color: var(--gold); }
#tree-tabs { display: flex; gap: 4px; margin: 6px 0; }
#tree-tabs button { flex: 1; padding: 3px 0; font-size: 12px; }
#tree-tabs button.on { background: #6a4aa8; }
#tree-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; align-items: stretch; }
#tree-grid .lv { color: var(--muted); font-size: 11px; align-self: center; }
#tree-grid button.node { min-height: 44px; padding: 3px; font-size: 11px; line-height: 1.15; background: #2a2044; border: 2px solid #000; color: var(--text, #eee); cursor: pointer; text-align: center; }
#tree-grid button.node.passive { border-radius: 14px; }
#tree-grid button.node b { display: block; color: var(--gold); font-weight: normal; }
#tree-grid button.node.ranked { background: #44306e; border-color: var(--gold); }
#tree-grid button.node.ready { border-color: #7ae87a; }
#tree-grid button.node.locked { opacity: 0.45; cursor: default; }
#tree-grid .spacer { min-height: 0; }
#aff-bar { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px; margin: 4px 0; }
#aff-bar .aff { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 4px; background: #2a2044; border: 2px solid #000; }
#aff-bar .aff-name { font-size: 11px; line-height: 16px; white-space: nowrap; color: var(--muted); }
#aff-bar .aff-val { font-size: 14px; line-height: 16px; color: var(--gold); }
#aff-bar button { min-width: 24px; min-height: 24px; padding: 0; font-size: 14px; line-height: 16px; }
#aff-bar button:disabled { opacity: 0.4; cursor: default; }
#tree-grid button.node.sel { outline: 2px solid #fff; outline-offset: -2px; }
#tree-detail { margin: 8px 0; padding: 8px; background: #1d1630; border: 2px solid #000; font-size: 12px; line-height: 16px; }
#tree-detail p { margin: 4px 0; }
#tree-detail .td-head { display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
#tree-detail .td-rank { margin-left: auto; color: var(--gold); }
#tree-detail .td-title { color: var(--muted); }
#tree-detail .td-req { list-style: none; margin: 4px 0; padding: 0; }
#tree-detail .td-req li.ok { color: #7ae87a; }
#tree-detail .td-req li.bad { color: #ff8a8a; }
#tree-detail .td-why { color: #ff8a8a; }
#tree-detail .td-go { margin-top: 8px; width: 100%; min-height: 28px; }
#tree-detail .td-go:disabled { opacity: 0.5; cursor: default; }
#respec { margin-top: 8px; }
.skill-row { display: flex; justify-content: space-between; }
.skill-bar { height: 7px; border: 2px solid #000; background: #0c0912; margin-top: 2px; }
