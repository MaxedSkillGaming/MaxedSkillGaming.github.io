/* ==== HUD theme (design/ux/hud.md): one family of dark violet metal with gold trim.
   Tokens first, then every HUD surface reads from them. Layout rules above are untouched. */
:root {
  --hud-top: #2d2349;
  --hud-bot: #170f26;
  --hud-line: #0a0710;
  --hud-bevel: #6a58a0;
  --hud-inner: #3a2d5a;
  --trim: #c79a3e;
  --trim-hi: #f4d77f;
  --trim-lo: #7a5a20;
  --hp-hi: #ff8a78;
  --hp-mid: #c2413f;
  --hp-lo: #6e1a22;
  --mp-hi: #86b6ff;
  --mp-mid: #3f6fd0;
  --mp-lo: #1c3678;
}

/* Panel surface shared by every HUD frame. */
#hud,
#toast,
#chatlog,
#chatinput,
.fbox,
#hover-tip,
#ui-tip,
#bar-picker,
#node-menu,
.grp-pop,
#menu-list,
.side,
#dialog {
  background: linear-gradient(180deg, var(--hud-top), var(--hud-bot));
  border: 2px solid var(--hud-line);
  box-shadow: inset 0 1px 0 var(--hud-bevel), inset 0 0 0 2px var(--hud-inner), 0 2px 0 #000, 0 6px 14px rgba(0, 0, 0, 0.45);
}
#chatlog, #chatinput { background: linear-gradient(180deg, rgba(36, 28, 58, 0.9), rgba(18, 12, 30, 0.9)); }
#toast { border-color: var(--hud-line); box-shadow: inset 0 0 0 2px #7a2a2a, 0 2px 0 #000, 0 6px 14px rgba(0, 0, 0, 0.45); }
#hud { font-size: 11px; color: var(--muted); }
.fgrip { background: linear-gradient(180deg, #3d2f63, #231a3b); color: var(--trim-hi); text-shadow: 1px 1px 0 #000; border-bottom: 2px solid var(--hud-line); letter-spacing: 0.5px; }
.side h2, .modal-box h2, #dialog h3 { color: var(--trim-hi); text-shadow: 1px 1px 0 #000; }

/* Buttons that live on the HUD: dock, map buttons, chat tabs, fight toggles. */
#toolbar button,
#rctl button,
#chattabs button,
#chat-clear,
#mbar button {
  position: relative;
  color: var(--ink);
  text-shadow: 1px 1px 0 #000;
  background: linear-gradient(180deg, #4b3b78, #2c2248);
  border: 2px solid var(--hud-line);
  box-shadow: inset 0 1px 0 var(--hud-bevel), inset 0 -2px 0 rgba(0, 0, 0, 0.35);
  transition: transform 80ms, background 80ms, box-shadow 80ms;
}#toolbar button:hover:not(:disabled),
#rctl button:hover:not(:disabled),
#chattabs button:hover,
#chat-clear:hover,
#mbar button:hover:not(:disabled) {
  background: linear-gradient(180deg, #5f4d96, #3a2d5e);
  box-shadow: inset 0 1px 0 var(--trim-hi), inset 0 0 0 1px var(--trim), inset 0 -2px 0 rgba(0, 0, 0, 0.35);
  transform: translateY(-1px);
}#toolbar button:active:not(:disabled),
#rctl button:active:not(:disabled),
#chattabs button:active,
#chat-clear:active,
#mbar button:active:not(:disabled) {
  transform: translateY(1px);
  box-shadow: inset 0 2px 0 rgba(0, 0, 0, 0.5);
}
#toolbar button:disabled, #rctl button:disabled { opacity: 0.45; }
#toolbar button:focus-visible, #rctl button:focus-visible, #chattabs button:focus-visible, .bslot:focus-visible, .qslot:focus-visible { outline: 2px solid var(--trim-hi); outline-offset: 1px; }
#chattabs button { opacity: 0.7; }
#chattabs button.on { opacity: 1; color: var(--trim-hi); border-color: var(--hud-line); box-shadow: inset 0 -3px 0 var(--trim), inset 0 1px 0 var(--hud-bevel); }
.grp.open .grp-btn { background: linear-gradient(180deg, #6d59a8, #43356d); }

/* Vials: a pixel potion flask drawn on a 16x16 grid (see drawFlask in game.js), no smooth glass. */
.globe {
  --f: 1;
  width: 80px;
  height: 80px;
  border: 0;
  border-radius: 0;
  overflow: visible;
  background: none;
  box-shadow: none;
  clip-path: none;
}
.globe:before, .globe:after { content: none; }
.globe canvas { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; }
.globe span { z-index: 2; top: auto; bottom: 8px; height: auto; font-size: 12px; font-weight: bold; letter-spacing: 0; white-space: nowrap; text-shadow: 1px 1px 0 #000, -1px 0 0 #000, 0 -1px 0 #000, 1px 0 0 #000; }
.globe.hp.low canvas { animation: orblow 900ms steps(4) infinite; }
@media (pointer: coarse), (max-width: 760px) { .globe { width: 48px; height: 48px; } .globe span { font-size: 10px; bottom: 4px; } }
@keyframes orblow { 0%, 100% { filter: brightness(0.9); } 50% { filter: brightness(1.5); } }

/* Hotbar and quick slots: bevelled plates with a key hint, lift on hover, sink on press. */
.bslot, .qslot, .sslot {
  background: linear-gradient(180deg, #2f2449, #150e24);
  border: 2px solid var(--hud-line);
  box-shadow: inset 0 1px 0 var(--hud-bevel), inset 0 0 0 2px var(--hud-inner), inset 0 -3px 0 rgba(0, 0, 0, 0.4);
  transition: transform 80ms, box-shadow 80ms;
}
.bslot:hover:not(.empty):not(.off), .qslot:hover, .sslot:hover { transform: translateY(-2px); box-shadow: inset 0 1px 0 var(--trim-hi), inset 0 0 0 2px var(--trim), inset 0 -3px 0 rgba(0, 0, 0, 0.4), 0 4px 0 #000; }
.bslot:active, .qslot:active, .sslot:active { transform: translateY(1px); box-shadow: inset 0 2px 0 rgba(0, 0, 0, 0.6); }
.bslot.empty { border-style: solid; border-color: var(--hud-line); background: linear-gradient(180deg, #1e1631, #0f0a1a); box-shadow: inset 0 0 0 2px #251c3a; }
.bslot.selected { outline: 2px solid var(--trim-hi); outline-offset: 1px; box-shadow: inset 0 0 0 2px var(--trim), 0 0 12px rgba(244, 215, 127, 0.55); }
.bslot.held { box-shadow: inset 0 0 0 2px var(--trim); }
.bslot .hk, .qslot .hk, .sslot .hk { left: 3px; top: 3px; padding: 0 3px; background: rgba(0, 0, 0, 0.75); color: var(--trim-hi); border-radius: 2px; font-size: 10px; line-height: 11px; }
.bslot .cost { right: 3px; bottom: 3px; border-radius: 2px; background: #1c3a78; box-shadow: 0 0 0 1px #000; }
.bslot .cd { background: rgba(8, 4, 16, 0.72); font-weight: bold; text-shadow: 1px 1px 0 #000; }
.qslot .cnt { right: 3px; bottom: 3px; border-radius: 2px; background: rgba(0, 0, 0, 0.8); }
.bslot.off, .qslot.off, .sslot.off { filter: grayscale(0.85) brightness(0.6); }
#hotbar:before { color: var(--trim); }

/* XP strip: gold fill, black ticks, flash on gain. */
#hotcol .meter.xp { border: 2px solid var(--hud-line); background: linear-gradient(180deg, #120a22, #07040d); box-shadow: 0 0 0 1px var(--trim-lo), inset 0 2px 0 rgba(0, 0, 0, 0.6); }
#hotcol .meter.xp .meter-fill { background: linear-gradient(180deg, var(--trim-hi), var(--trim) 55%, var(--trim-lo)); box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.35); }

/* Buffs. */
#buffs .buff { border: 2px solid var(--hud-line); box-shadow: inset 0 0 0 1px var(--hud-inner); background: linear-gradient(180deg, #2f2449, #150e24); }
#buffs .buff.good { border-color: #2f6b3a; box-shadow: 0 0 0 1px #000, 0 0 6px rgba(80, 200, 110, 0.45); }
#buffs .buff.debuff { border-color: #8a2f2f; box-shadow: 0 0 0 1px #000, 0 0 6px rgba(220, 70, 70, 0.5); }

/* Chat: easy on the eyes when you are not using it. */
#chat { transition: opacity 200ms; }
#chat:not(:hover):not(:focus-within) { opacity: 0.72; }
#chatinput:focus { outline: 2px solid var(--trim-hi); outline-offset: 0; }



@media (prefers-reduced-motion: reduce) {
  .globe.hp.low canvas { animation: none; }
  .bslot, .qslot, .sslot, #toolbar button, #rctl button { transition: none; }
  #hotcol .meter.xp.gain { animation: none; }
}

/* Pass 2: a metal plate under the action cluster, bigger slots, text at 11px or more, tidy dock and chat scrollbar. */
#hotrow { padding: 8px; gap: 8px; align-items: flex-end; background: linear-gradient(180deg, var(--hud-top), var(--hud-bot)); border: 2px solid var(--hud-line); border-top-color: var(--trim); box-shadow: inset 0 1px 0 var(--trim-hi), inset 0 0 0 2px var(--hud-inner), 0 2px 0 #000, 0 6px 14px rgba(0, 0, 0, 0.5); }
.bslot { max-width: 52px; }
.qslot, .sslot { width: 44px; height: 44px; }
.sslot { font-size: 11px; }
.bslot .hk, .qslot .hk, .sslot .hk { font-size: 11px; line-height: 12px; }
.bslot .cost, .qslot .cnt, .sslot .cnt, .qslot .plus { font-size: 11px; line-height: 12px; }
.bslot.auto { font-size: 11px; }
#hotbar:before { font-size: 11px; line-height: 12px; top: -15px; letter-spacing: 1px; }
#hotcol .meter.xp { margin-bottom: 18px; }
#hotcol .meter.xp span { font-size: 11px; }
.meter.xp span { font-size: 11px; }
#toolbar .grp:last-child { grid-column: span 2; }
#chatlog { scrollbar-width: thin; scrollbar-color: var(--trim-lo) rgba(10, 7, 16, 0.6); }
#chatlog li { line-height: 1.35; }
#chattabs button, #chat-clear { font-size: 11px; }
.sslot { padding-top: 10px; }
#hotcol .meter.xp span { z-index: 1; }




/* Safe margin: at least 8 real pixels from every window edge, whatever the UI scale. */
#hud { top: max(10px, calc(8px / var(--ui, 1))); left: max(10px, calc(8px / var(--ui, 1))); }
#chat { left: max(10px, calc(8px / var(--ui, 1))); bottom: max(10px, calc(8px / var(--ui, 1))); }
#toolbar { right: max(10px, calc(8px / var(--ui, 1))); }
#rctl { right: max(10px, calc(8px / var(--ui, 1))); }
#mapbox { right: max(10px, calc(8px / var(--ui, 1))); }
#bhud { right: max(10px, calc(8px / var(--ui, 1))); bottom: max(10px, calc(8px / var(--ui, 1))); }
.wide-hud #toolbar { bottom: max(10px, calc(8px / var(--ui, 1))); }
#toolbar { top: max(10px, calc(8px / var(--ui, 1))); }
.wide-hud #toolbar { top: auto; }
.wide-hud #toolbar { width: min(440px, calc(var(--vw, 100vw) - min(380px, calc(var(--vw, 100vw) * 0.34)) - 24px - 768px - max(10px, calc(8px / var(--ui, 1))))); }
.wide-hud #rctl { top: max(8px, calc(8px / var(--ui, 1))); }

@media (pointer: coarse), (max-width: 760px) {
  #bhud { left: max(8px, calc(8px / var(--ui, 1))); }
  /* The phone hotbar is two rows tall, so chat sits above it (8 margin + 104 bar + 8 gap). */
  #chat { bottom: calc(120px / var(--ui, 1)); }
}



/* Touch targets: 40 real pixels whatever the UI scale. */
@media (pointer: coarse), (max-width: 760px) {#menu-btn,
#rctl button,
#toolbar > button,
#menu-list button { min-height: calc(40px / var(--ui, 1)); min-width: calc(40px / var(--ui, 1)); }
}
@media (pointer: coarse), (max-width: 760px) {
  #rctl { top: calc(72px / var(--ui, 1)); }
  #mapbox { top: calc(120px / var(--ui, 1)); }
}

/* Real-time fights: the action timer drains down the hotbar (--gcd runs from 1 to 0) and cooldowns count in seconds. */
#hotbar { --gcd: 0; }
#hotbar .bslot:not(.empty)::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--gcd) * 100%); background: rgba(8, 4, 16, 0.55); pointer-events: none; }
.sslot.guard { border-color: #4a6aa0; }
.sslot.guard b { font-weight: normal; color: #e8e0f0; }

/* Chat, RuneScape style: one see-through panel, hard-shadowed text, the input under the log, tabs along the bottom. */
#chat {
  display: grid;
  grid-template-columns: 1fr auto;
  grid-template-rows: minmax(0, 1fr) auto auto;
  grid-template-areas: "log log" "form form" "tabs nav";
  background: rgba(8, 6, 14, 0.55);
  border: 2px solid rgba(0, 0, 0, 0.7);
  opacity: 1;
}
#chat:not(:hover):not(:focus-within) { opacity: 1; }
#chatlog { grid-area: log; margin: 0; padding: 4px 8px; background: none; border: 0; box-shadow: none; font-size: 13px; color: #f0e8ff; text-shadow: 1px 1px 0 #000; }
#chatform { grid-area: form; margin: 0; border-top: 1px solid rgba(255, 255, 255, 0.14); }
#chatinput { background: rgba(0, 0, 0, 0.4); border: 0; border-radius: 0; box-shadow: none; padding: 4px 8px; font-size: 13px; text-shadow: 1px 1px 0 #000; }
#chattabs { grid-area: tabs; margin: 0; gap: 0; }
#chatnav { grid-area: nav; margin: 0; }
#chattabs button, #chatnav button, #chattabs button:hover, #chatnav button:hover, #chattabs button:active, #chatnav button:active {
  margin: 0;
  padding: 3px 12px;
  min-height: 24px;
  font-size: 11px;
  background: rgba(0, 0, 0, 0.5);
  border: 0;
  border-top: 2px solid transparent;
  border-right: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 0;
  box-shadow: none;
  transform: none;
  opacity: 0.85;
}
#chattabs button:hover, #chatnav button:hover { background: rgba(70, 54, 110, 0.6); opacity: 1; }
#chattabs button.on { background: rgba(110, 82, 36, 0.6); border-top-color: var(--trim-hi); box-shadow: none; opacity: 1; }
